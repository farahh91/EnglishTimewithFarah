/* ---- marking by hand (voice notes, or writing the AI could not mark) ---- */

function findResultRow_(sh, c, l, s) {
  if (!sh || sh.getLastRow() < 2) return null;
  const rows = sh.getRange(2, 1, sh.getLastRow() - 1, 10).getValues();
  for (let i = 0; i < rows.length; i++) {
    const r = rows[i];
    if (normCode_(r[2]) === c && Number(r[3]) === l && Number(r[4]) === s) return { row: i + 2, vals: r };
  }
  return null;
}

function saveMarks_(sh, f, marks) {
  const total = Number(f.vals[6]);
  const score = sumMarks_(marks);
  sh.getRange(f.row, 6).setValue(score);
  sh.getRange(f.row, 8).setValue(total ? score / total : 0);
  sh.getRange(f.row, 10).setNumberFormat('@').setValue(JSON.stringify(marks));
  return { ok: true, score: score, total: total };
}

/** Teacher gives (or changes) the mark of one writing or voice question. points = 0 to 10. */
function api_t_setMark(token, code, level, session, idx, points, feedback) {
  return teacher_(token, function () {
    const c = normCode_(code), l = int_(level, CONFIG.LEVELS), s = int_(session, CONFIG.SESSIONS);
    const k = Number(idx), pts = Number(points);
    if (!c || !l || !s || !Number.isInteger(k) || k < 0 || !isFinite(pts) || pts < 0 || pts > 10) {
      return { ok: false, error: 'That mark is not valid. Use a number from 0 to 10.' };
    }
    const lock = LockService.getScriptLock();
    lock.waitLock(20000);
    try {
      const sh = db_().getSheetByName(SHEET.RESULTS);
      const f = findResultRow_(sh, c, l, s);
      if (!f) return { ok: false, error: 'No attempt found.' };
      const marks = parseAnswers_(f.vals[9]);
      const qs = readQuizzes_()[l + '-' + s];
      if (!marks || !qs || marks.length !== qs.length || k >= marks.length || !isManual_(qs[k].type)) {
        return { ok: false, error: 'This attempt cannot be marked by hand because the questions were changed.' };
      }
      const old = marks[k] || {};
      const nm = { p: Math.round(pts * 10) / 100, f: String(feedback == null ? '' : feedback).replace(/\s+/g, ' ').trim().slice(0, 500) };
      if (old.c) nm.c = old.c;
      marks[k] = nm;
      return saveMarks_(sh, f, marks);
    } finally {
      lock.releaseLock();
    }
  });
}

/** Teacher asks the AI to mark one writing question again (for example when the AI key was added later). */
function api_t_aiRecheck(token, code, level, session, idx) {
  return teacher_(token, function () {
    const c = normCode_(code), l = int_(level, CONFIG.LEVELS), s = int_(session, CONFIG.SESSIONS), k = Number(idx);
    if (!c || !l || !s || !Number.isInteger(k) || k < 0) return { ok: false, error: 'That attempt does not exist.' };
    if (!aiKey_()) return { ok: false, error: 'There is no AI key yet. In the Sheet use Quiz portal > Set AI key.' };
    const lock = LockService.getScriptLock();
    lock.waitLock(20000);
    try {
      const sh = db_().getSheetByName(SHEET.RESULTS);
      const f = findResultRow_(sh, c, l, s);
      if (!f) return { ok: false, error: 'No attempt found.' };
      const marks = parseAnswers_(f.vals[9]), answers = parseAnswers_(f.vals[8]);
      const qs = readQuizzes_()[l + '-' + s];
      if (!marks || !answers || !qs || marks.length !== qs.length || answers.length !== qs.length || k >= qs.length || qs[k].type !== 'writing') {
        return { ok: false, error: 'This question cannot be checked again.' };
      }
      const o = aiGradeAll_([{ q: qs[k], level: l, text: String(answers[k]) }])[0];
      if (!o || !o.ok) return { ok: false, error: 'The AI could not mark it: ' + (o ? o.error : 'no reply') };
      marks[k] = { p: o.pts, f: o.feedback, c: o.corrected };
      return saveMarks_(sh, f, marks);
    } finally {
      lock.releaseLock();
    }
  });
}

