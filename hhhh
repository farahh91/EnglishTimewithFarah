/** New students apply here (no login). Saved in the Applicants sheet. */
function api_apply(name, phone, email, note, trap) {
  return safe_(function () {
    if (trap) return { ok: true };   // a hidden box that only robots fill in: pretend it worked
    const nm = String(name == null ? '' : name).replace(/\s+/g, ' ').trim().replace(/^[=+\-@\s]+/, '').slice(0, 80);
    const raw = String(phone == null ? '' : phone).trim();
    const dg = digitsOf_(raw);
    const em = String(email == null ? '' : email).trim().toLowerCase().slice(0, 120);
    const nt = String(note == null ? '' : note).replace(/\s+/g, ' ').trim().replace(/^[=+\-@\s]+/, '').slice(0, 300);
    if (nm.length < 2) return { ok: false, error: 'Write your full name.' };
    if (dg.length < 7 || dg.length > 15) return { ok: false, error: 'Write your phone or WhatsApp number, for example +20 10 1234 5678.' };
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(em)) return { ok: false, error: 'Write a correct email address.' };

    const cache = CacheService.getScriptCache();
    const sent = Number(cache.get('apps') || 0);
    if (sent >= 60) return { ok: false, error: 'Many people are applying right now. Please try again in a little while.' };
    cache.put('apps', String(sent + 1), 3600);

    const lock = LockService.getScriptLock();
    lock.waitLock(20000);
    try {
      const sh = db_().getSheetByName(SHEET.APPLICANTS);
      if (!sh) return { ok: false, error: 'Applications are not open yet. Please ask your teacher.' };
      const wa = waDigits_(raw);
      const have = readApplicants_().rows;
      for (let i = 0; i < have.length; i++) {
        if (have[i].status !== 'Declined' && waDigits_(have[i].phone) === wa) return { ok: true };  // already applied
      }
      const row = [['a' + Utilities.getUuid().replace(/-/g, '').slice(0, 7), new Date().toISOString(), nm,
        (raw.charAt(0) === '+' ? '+' : '') + dg, em, nt, 'New', '']];
      const start = Math.max(lastFilled_(sh, 3), lastFilled_(sh, 1)) + 1;
      ensureRows_(sh, start);
      sh.getRange(start, 1, 1, 8).setNumberFormat('@');
      sh.getRange(start, 1, 1, 8).setValues(row);
      return { ok: true };
    } finally {
      lock.releaseLock();
    }
  });
}

/* ====================== Teacher portal ====================== */

const TEACHER_SESSION_SECONDS = 6 * 60 * 60;

function sha_(text) {
  return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, text)
    .map(function (b) { return ('0' + (b & 255).toString(16)).slice(-2); }).join('');
}

/** Menu item: the teacher chooses the password for the Teacher portal. */
function setTeacherPassword() {
  const ui = ui_();
  if (!ui) { alert_('Open the Google Sheet and use the Quiz portal menu there. This one needs the Sheet window.'); return; }
  const res = ui.prompt('Teacher password', 'Choose a password for the Teacher portal (at least 6 characters):', ui.ButtonSet.OK_CANCEL);
  if (res.getSelectedButton() !== ui.Button.OK) return;
  const pw = String(res.getResponseText() || '');
  if (pw.length < 6) { alert_('That password is too short. Use at least 6 characters.'); return; }
  saveTeacherPassword_(pw);
  alert_('Teacher password saved. Open the web app and use the small Instructors link at the bottom of the front page.');
}

function saveTeacherPassword_(pw) {
  const props = PropertiesService.getScriptProperties();
  const salt = Utilities.getUuid();
  props.setProperty('TP_SALT', salt);
  props.setProperty('TP_HASH', sha_(salt + ':' + pw));
}

function teacherConfigured_() {
  return !!CONFIG.TEACHER_PASSWORD || !!PropertiesService.getScriptProperties().getProperty('TP_HASH');
}

function passwordOk_(pw) {
  pw = String(pw == null ? '' : pw);
  if (!pw) return false;
  if (CONFIG.TEACHER_PASSWORD) return pw === CONFIG.TEACHER_PASSWORD;
  const props = PropertiesService.getScriptProperties();
  const salt = props.getProperty('TP_SALT'), hash = props.getProperty('TP_HASH');
  return !!(salt && hash && sha_(salt + ':' + pw) === hash);
}

function api_teacherLogin(password) {
  return safe_(function () {
    if (!teacherConfigured_()) {
      return { ok: false, error: 'No teacher password yet. In the Google Sheet use Quiz portal > Set teacher password.' };
    }
    const cache = CacheService.getScriptCache();
    const fails = Number(cache.get('tfail') || 0);
    if (fails >= 8) return { ok: false, error: 'Too many wrong tries. Wait 5 minutes and try again.' };
    if (!passwordOk_(password)) {
      cache.put('tfail', String(fails + 1), 300);
      return { ok: false, error: 'Wrong password.' };
    }
    cache.remove('tfail');
    const token = Utilities.getUuid() + Utilities.getUuid();
    cache.put('tt:' + token, '1', TEACHER_SESSION_SECONDS);
    return { ok: true, token: token };
  });
}

/** Runs fn only when the token belongs to a logged-in teacher. */
function teacher_(token, fn) {
  return safe_(function () {
    const valid = token && CacheService.getScriptCache().get('tt:' + String(token));
    if (!valid) return { ok: false, auth: true, error: 'Your teacher session ended. Log in again.' };
    return fn();
  });
}

function ensureRows_(sh, n) {
  if (sh.getMaxRows() < n) sh.insertRowsAfter(sh.getMaxRows(), n - sh.getMaxRows());
}

/** Last row that has something in the given column. */
function lastFilled_(sh, col) {
  const vals = sh.getRange(1, col, sh.getMaxRows(), 1).getValues();
  for (let i = vals.length - 1; i >= 0; i--) if (String(vals[i][0]).trim() !== '') return i + 1;
  return 1;
}

