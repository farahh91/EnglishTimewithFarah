/** Accepting an applicant adds them to the Students sheet with a new code. */
function api_t_acceptApplicant(token, id, level, months) {
  return teacher_(token, function () {
    const lock = LockService.getScriptLock();
    lock.waitLock(20000);
    try {
      const d = readApplicants_();
      const a = d.rows.filter(function (x) { return x.id === String(id); })[0];
      if (!a) return { ok: false, error: 'Application not found.' };
      if (a.status === 'Accepted' && a.code) return { ok: true, code: a.code };
      const sh = db_().getSheetByName(SHEET.STUDENTS);
      if (!sh) return { ok: false, error: 'The Students sheet is missing. Run setup first.' };
      const used = new Set();
      if (sh.getLastRow() > 1) {
        sh.getRange(2, 2, sh.getLastRow() - 1, 1).getValues().forEach(function (r) { const c = normCode_(r[0]); if (c) used.add(c); });
      }
      const code = newCode_(used);
      const start = Math.max(lastFilled_(sh, 1), lastFilled_(sh, 2)) + 1;
      ensureRows_(sh, start);
      sh.getRange(start, 1, 1, 2).setNumberFormat('@');
      const lv = int_(level, CONFIG.LEVELS) || 1;
      const mo = (Number.isInteger(Number(months)) && Number(months) >= 1 && Number(months) <= 36) ? Number(months) : 1;
      sh.getRange(start, 1, 1, 5).setValues([[a.name, code, new Date(), lv, mo]]);
      d.sh.getRange(a.row, 7, 1, 2).setNumberFormat('@').setValues([['Accepted', code]]);
      return { ok: true, code: code };
    } finally {
      lock.releaseLock();
    }
  });
}

function api_t_deleteApplicant(token, id) {
  return teacher_(token, function () {
    const lock = LockService.getScriptLock();
    lock.waitLock(20000);
    try {
      const d = readApplicants_();
      const a = d.rows.filter(function (x) { return x.id === String(id); })[0];
      if (!a) return { ok: false, error: 'Application not found.' };
      d.sh.deleteRow(a.row);
      return { ok: true };
    } finally {
      lock.releaseLock();
    }
  });
}

/* ---- students: level and months booked ---- */

function api_t_updateStudent(token, code, level, months) {
  return teacher_(token, function () {
    const c = normCode_(code), l = int_(level, CONFIG.LEVELS), m = Number(months);
    if (!c || !l) return { ok: false, error: 'Choose a level from 1 to ' + CONFIG.LEVELS + '.' };
    if (!Number.isInteger(m) || m < 1 || m > 36) return { ok: false, error: 'Months booked must be a whole number from 1 to 36.' };
    const lock = LockService.getScriptLock();
    lock.waitLock(20000);
    try {
      const sh = db_().getSheetByName(SHEET.STUDENTS);
      if (!sh || sh.getLastRow() < 2) return { ok: false, error: 'Student not found.' };
      const vals = sh.getRange(2, 1, sh.getLastRow() - 1, 2).getValues();
      for (let i = 0; i < vals.length; i++) {
        if (normCode_(vals[i][1]) === c) {
          sh.getRange(i + 2, 4, 1, 2).setNumberFormat('0').setValues([[l, m]]);
          return { ok: true, level: l, months: m };
        }
      }
      return { ok: false, error: 'Student not found.' };
    } finally {
      lock.releaseLock();
    }
  });
}

/** What a student's home page needs: their level, months, quizzes of that level only, personal exam times, next live session. */
function studentView_(st) {
  const info = quizInfo_(), mine = {}, sched = {};
  Object.keys(info).forEach(function (k) { if (st.level && k.split('-')[0] === String(st.level)) mine[k] = info[k]; });
  readSchedule_().forEach(function (x) { if (x.code === st.code && x.level === st.level) sched[x.level + '-' + x.session] = { start: x.start }; });
  return {
    level: st.level, months: st.months, quizzes: mine, sched: sched,
    results: st.level ? resultsFor_(st.code, st.level) : {},
    live: st.level ? liveFor_(st.level) : null,
    now: Date.now(), examMinutes: CONFIG.EXAM_WINDOW_MINUTES,
    sessionMinutes: CONFIG.SESSION_MINUTES, reminderMinutes: CONFIG.REMINDER_MINUTES
  };
}

/* ---- rescheduling an exam for one student ---- */

function readSchedule_() {
  const sh = db_().getSheetByName(SHEET.SCHEDULE);
  const rows = [];
  if (!sh || sh.getLastRow() < 2) return rows;
  sh.getRange(2, 1, sh.getLastRow() - 1, 6).getValues().forEach(function (r, i) {
    const c = normCode_(r[1]), l = int_(r[2], CONFIG.LEVELS), s = int_(r[3], CONFIG.SESSIONS);
    const start = r[4] instanceof Date ? r[4].toISOString() : String(r[4]).trim();
    if (!c || !l || !s || !isFinite(Date.parse(start))) return;
    rows.push({ row: i + 2, code: c, level: l, session: s, start: start });
  });
  return rows;
}

function scheduleFor_(code, l, s) {
  const m = readSchedule_().filter(function (x) { return x.code === code && x.level === l && x.session === s; });
  return m.length ? m[m.length - 1] : null;
}

/** Removes a personal exam time. The caller already holds the script lock (or does not need it). */
function removeSchedule_(code, l, s) {
  const sh = db_().getSheetByName(SHEET.SCHEDULE);
  if (!sh) return;
  readSchedule_().filter(function (x) { return x.code === code && x.level === l && x.session === s; })
    .sort(function (a, b) { return b.row - a.row; })
    .forEach(function (x) { sh.deleteRow(x.row); });
}

/** Removes the saved result of one attempt. The caller holds the script lock. */
function deleteResults_(c, l, s) {
  const sh = db_().getSheetByName(SHEET.RESULTS);
  if (!sh || sh.getLastRow() < 2) return;
  const rows = sh.getRange(2, 1, sh.getLastRow() - 1, 9).getValues();
  for (let i = rows.length - 1; i >= 0; i--) {
    if (normCode_(rows[i][2]) === c && Number(rows[i][3]) === l && Number(rows[i][4]) === s) sh.deleteRow(i + 2);
  }
}

/**
 * May this student start this quiz now? Their own level only. A personal exam time (set by the teacher)
 * replaces the class-wide open/closed switch. late = true when they are sending the answers (a few minutes of grace).
 */
function examAccess_(st, l, s, late) {
  if (!st.level) return { ok: false, error: 'Your teacher has not set your level yet.' };
  if (l !== st.level) return { ok: false, error: 'This quiz is not in your level.' };
  const sc = scheduleFor_(st.code, l, s);
  if (sc) {
    const now = Date.now(), t0 = Date.parse(sc.start), t1 = t0 + CONFIG.EXAM_WINDOW_MINUTES * 60000 + (late ? 15 * 60000 : 0);
    if (now < t0) return { ok: false, error: 'Your teacher scheduled this exam for a later time. Check the time on your quiz list.' };
    if (now > t1) return { ok: false, error: 'The time for this exam has passed. Ask your teacher to schedule it again.' };
    return { ok: true };
  }
  if (!openMap_()[l + '-' + s]) {
    return { ok: false, error: late ? 'This quiz was closed by your teacher, so it could not be sent.' : 'This quiz is closed. Your teacher will open it in class.' };
  }
  return { ok: true };
}

function api_t_reschedule(token, code, level, session, iso, reset) {
  return teacher_(token, function () {
    const c = normCode_(code), l = int_(level, CONFIG.LEVELS), s = int_(session, CONFIG.SESSIONS), t = Date.parse(String(iso || ''));
    if (!c || !l || !s) return { ok: false, error: 'Choose a level and a session.' };
    if (!isFinite(t)) return { ok: false, error: 'Choose the new date and time.' };
    if (t < Date.now() - 10 * 60000) return { ok: false, error: 'That time is in the past. Choose a time from now on.' };
    if (t > Date.now() + 400 * 86400000) return { ok: false, error: 'That date is too far away.' };
    const stu = findStudent_(c);
    if (!stu) return { ok: false, error: 'Student not found.' };
    if (stu.level !== l) return { ok: false, error: 'This student is in Level ' + (stu.level || '(not set)') + '. Choose that level, or change the student level first.' };
    const qs = readQuizzes_()[l + '-' + s];
    if (!qs || !qs.length) return { ok: false, error: 'That session has no quiz yet. Write it first in Quizzes.' };
    if (findResult_(c, l, s) && !reset) {
      return { ok: false, error: 'This student already took that exam. Tick the box to delete the old result so they can take it again.' };
    }
    const lock = LockService.getScriptLock();
    lock.waitLock(20000);
    try {
      const sh = db_().getSheetByName(SHEET.SCHEDULE);
      if (!sh) return { ok: false, error: 'The Schedule sheet is missing. Run setup first.' };
      if (reset) deleteResults_(c, l, s);
      removeSchedule_(c, l, s);
      const start = Math.max(lastFilled_(sh, 2), lastFilled_(sh, 1)) + 1;
      ensureRows_(sh, start);
      sh.getRange(start, 1, 1, 6).setNumberFormat('@');
      sh.getRange(start, 1, 1, 6).setValues([['x' + Utilities.getUuid().replace(/-/g, '').slice(0, 7), c, l, s, new Date(t).toISOString(), '']]);
      return { ok: true };
    } finally {
      lock.releaseLock();
    }
  });
}

function api_t_clearSchedule(token, code, level, session) {
  return teacher_(token, function () {
    const c = normCode_(code), l = int_(level, CONFIG.LEVELS), s = int_(session, CONFIG.SESSIONS);
    if (!c || !l || !s) return { ok: false, error: 'That exam time does not exist.' };
    const lock = LockService.getScriptLock();
    lock.waitLock(20000);
    try {
      removeSchedule_(c, l, s);
      return { ok: true };
    } finally {
      lock.releaseLock();
    }
  });
}

/* ---- live Zoom sessions ---- */

function readLive_() {
  const sh = db_().getSheetByName(SHEET.LIVE);
  const rows = [];
  if (!sh || sh.getLastRow() < 2) return { sh: sh, rows: rows };
  sh.getRange(2, 1, sh.getLastRow() - 1, 5).getValues().forEach(function (r, i) {
    const l = int_(r[1], CONFIG.LEVELS);
    const start = r[2] instanceof Date ? r[2].toISOString() : String(r[2]).trim();
    if (!l || !isFinite(Date.parse(start))) return;
    rows.push({ row: i + 2, id: String(r[0]).trim(), level: l, start: start, link: String(r[3]).trim(), note: String(r[4]).trim() });
  });
  return { sh: sh, rows: rows };
}

/** The current or next live session of a level (a session lasts SESSION_MINUTES from its start). */
function liveFor_(level) {
  const now = Date.now(), len = CONFIG.SESSION_MINUTES * 60000;
  const list = readLive_().rows.filter(function (x) { return x.level === level && Date.parse(x.start) + len > now; })
    .sort(function (a, b) { return Date.parse(a.start) - Date.parse(b.start); });
  if (!list.length) return null;
  const x = list[0];
  return { id: x.id || ('r' + x.row), start: x.start, link: x.link, note: x.note };
}

function api_t_live(token) {
  return teacher_(token, function () {
    const lock = LockService.getScriptLock();
    lock.waitLock(20000);
    let d;
    try {
      d = readLive_();
      d.rows.forEach(function (x) {
        if (!x.id) {   // a row typed by hand in the sheet: give it an id
          x.id = 'l' + Utilities.getUuid().replace(/-/g, '').slice(0, 7);
          d.sh.getRange(x.row, 1).setNumberFormat('@').setValue(x.id);
        }
      });
    } finally {
      lock.releaseLock();
    }
    const len = CONFIG.SESSION_MINUTES * 60000, now = Date.now();
    const list = d.rows.filter(function (x) { return Date.parse(x.start) + len > now - 3 * 3600000; })
      .sort(function (a, b) { return Date.parse(a.start) - Date.parse(b.start); })
      .map(function (x) { return { id: x.id, level: x.level, start: x.start, link: x.link, note: x.note }; });
    return { ok: true, list: list, minutes: CONFIG.SESSION_MINUTES, zoomDefault: CONFIG.ZOOM_LINK };
  });
}

/** Creates a live session (id empty) or changes one. */
function api_t_saveLive(token, id, level, iso, link, note) {
  return teacher_(token, function () {
    const l = int_(level, CONFIG.LEVELS), t = Date.parse(String(iso || ''));
    if (!l) return { ok: false, error: 'Choose a level.' };
    if (!isFinite(t)) return { ok: false, error: 'Choose the date and time.' };
    if (t < Date.now() - 60 * 60000) return { ok: false, error: 'That time has already passed. Choose a time from now on.' };
    if (t > Date.now() + 400 * 86400000) return { ok: false, error: 'That date is too far away.' };
    const lk = String(link == null ? '' : link).trim() || String(CONFIG.ZOOM_LINK || '');
    if (!/^https:\/\/[^\s<>"']+$/i.test(lk) || lk.length > 300) return { ok: false, error: 'Paste the full Zoom link. It must start with https://' };
    const nt = String(note == null ? '' : note).replace(/\s+/g, ' ').trim().slice(0, 200);
    const lock = LockService.getScriptLock();
    lock.waitLock(20000);
    try {
      const d = readLive_();
      if (!d.sh) return { ok: false, error: 'The Live sessions sheet is missing. Run setup first.' };
      const ex = id ? d.rows.filter(function (x) { return x.id === String(id); })[0] : null;
      if (id && !ex) return { ok: false, error: 'Session not found.' };
      const row = ex ? ex.row : Math.max(lastFilled_(d.sh, 2), lastFilled_(d.sh, 1), lastFilled_(d.sh, 3)) + 1;
      ensureRows_(d.sh, row);
      d.sh.getRange(row, 1, 1, 5).setNumberFormat('@');
      d.sh.getRange(row, 1, 1, 5).setValues([[ex ? ex.id : 'l' + Utilities.getUuid().replace(/-/g, '').slice(0, 7), l, new Date(t).toISOString(), lk, nt]]);
      return { ok: true };
    } finally {
      lock.releaseLock();
    }
  });
}

function api_t_deleteLive(token, id) {
  return teacher_(token, function () {
    const lock = LockService.getScriptLock();
    lock.waitLock(20000);
    try {
      const d = readLive_();
      const x = d.rows.filter(function (y) { return y.id === String(id); })[0];
      if (!x) return { ok: false, error: 'Session not found.' };
      d.sh.deleteRow(x.row);
      return { ok: true };
    } finally {
      lock.releaseLock();
    }
