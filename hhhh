      const start = Math.max(lastFilled_(sh, 1), lastFilled_(sh, 2)) + 1;
      ensureRows_(sh, start + rows.length - 1);
      sh.getRange(start, 1, rows.length, 2).setNumberFormat('@');
      sh.getRange(start, 1, rows.length, 5).setValues(rows);
