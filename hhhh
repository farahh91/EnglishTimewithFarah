/**
 * English Time with Farah - quiz portal backend (Google Apps Script)
 *
 * Paste this whole file into Code.gs of a Google Sheet's Apps Script project
 * (Extensions > Apps Script), then run setup(). The student and teacher pages are inside this file.
 *
 * Version 7 adds: a level and months booked for each student (students only see their own level), live Zoom sessions
 * with a reminder, and rescheduling an exam for one student.
 * Version 6 added: writing questions checked by AI, reading texts, voice-note questions on WhatsApp,
 * and a "New student? Apply" page with an applicants tab in the teacher area.
 */

const CONFIG = {
  TITLE: 'English Time with Farah',
  LEVELS: 12,
  SESSIONS: 8,            // sessions 1-7 have a quiz each; the last one (8) is the Final exam
  CODE_LENGTH: 6,
  // false: the code decides who the student is, the typed name is only a greeting.
  // true: the typed name must also match the name in the Students sheet.
  STRICT_NAME_CHECK: false,
  // Optional. If the web app ever says "Setup is not finished", paste your Sheet's ID here.
  // It is the long text in the Sheet's address: docs.google.com/spreadsheets/d/THIS-PART/edit
  SPREADSHEET_ID: '',
  // Optional. Normally you set the teacher password from the Sheet menu (Quiz portal > Set teacher password).
  // If you type one here instead, it is used and the menu password is ignored.
  TEACHER_PASSWORD: '',
  // After the Final exam, students see which questions they got right or wrong.
  // false: they do NOT see the correct answers. true: they do (like the other quizzes).
  SHOW_FINAL_EXAM_ANSWERS: false,

  // Your WhatsApp number for voice-note questions: country code + number, digits only (example: 201012345678).
  // Easier: set it from the Sheet menu (Quiz portal > Set my WhatsApp number).
  WHATSAPP_NUMBER: '',
  // Used to turn a number like 0101 234 5678 into an international WhatsApp link. 20 = Egypt.
  COUNTRY_CODE: '20',
  // The AI that checks writing. Set the key from the Sheet menu (Quiz portal > Set AI key), not here.
  AI_MODEL: 'claude-haiku-5-5',
  AI_API_KEY: '',

  // Live sessions on Zoom
  ZOOM_LINK: '',            // used when you do not write a Zoom link for a session
  SESSION_MINUTES: 60,      // every live session lasts one hour
  REMINDER_MINUTES: 5,      // students are reminded this many minutes before it starts
  // A rescheduled exam can be started from the chosen time until this many minutes later.
  EXAM_WINDOW_MINUTES: 120
};

const SHEET = {
  STUDENTS: 'Students', QUIZZES: 'Quizzes', RESULTS: 'Results', GRADES: 'Grades', CONTROL: 'Control',
  PASSAGES: 'Passages', APPLICANTS: 'Applicants', LIVE: 'Live sessions', SCHEDULE: 'Schedule'
};
// No 0/O/1/I/L and no E, so a code can never be mistaken for a number such as 2E5.
const CODE_LETTERS = 'ABCDFGHJKMNPQRSTUVWXYZ';
const CODE_CHARS = CODE_LETTERS + '23456789';
const APPLICANT_STATUS = ['New', 'Contacted', 'Accepted', 'Declined'];

/* ====================== Sheet menu and setup ====================== */

/**
 * Adds the "Quiz portal" menu when the Sheet opens.
 * Do not press Run on this from the Apps Script editor: menus only exist inside the Sheet.
 */
function onOpen() {
  const ui = ui_();
  if (!ui) return;
  ui.createMenu('Quiz portal')
    .addItem('Set up sheets (run once)', 'setup')
    .addItem('Set teacher password', 'setTeacherPassword')
    .addItem('Set AI key (checks writing)', 'setAiKey')
    .addItem('Test the AI checker', 'testAi')
    .addItem('Set my WhatsApp number', 'setWhatsApp')
    .addItem('Generate missing student codes', 'generateCodes')
    .addItem('Test a student code', 'testCode')
    .addItem('Check my setup', 'checkSetup')
    .addItem('Show web app link', 'showLink')
    .addToUi();
}

/** The Sheet's dialog window, or null when the script is run from the Apps Script editor. */
function ui_() {
  try { return SpreadsheetApp.getUi(); } catch (e) { return null; }
}

/** Shows a message in the Sheet. Falls back to a toast and the execution log outside the Sheet. */
function alert_(msg) {
  const ui = ui_();
  if (ui) { ui.alert(msg); return; }
  try { SpreadsheetApp.getActiveSpreadsheet().toast(msg, 'Quiz portal', 15); } catch (e) { /* ignore */ }
  Logger.log(msg);
}

/** Typing a name in the Students sheet fills in a code automatically. */
function onEdit(e) {
  try {
    if (!e || !e.range) return;
    const sh = e.range.getSheet();
    if (sh.getName() !== SHEET.STUDENTS || e.range.getRow() < 2) return;
    fillCodes_(sh);
  } catch (err) { /* ignore */ }
}

function setup() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  PropertiesService.getScriptProperties().setProperty('SS_ID', ss.getId());

  const students = sheet_(ss, SHEET.STUDENTS, ['Name', 'Code', 'Created']);
  const quizzes = sheet_(ss, SHEET.QUIZZES, ['Level', 'Session', 'Question', 'A', 'B', 'C', 'D', 'Correct', 'Type']);
  const control = sheet_(ss, SHEET.CONTROL, ['Level', 'Session', 'Open']);
  const results = sheet_(ss, SHEET.RESULTS, ['Time', 'Name', 'Code', 'Level', 'Session', 'Score', 'Total', 'Percent', 'Answers', 'Marks']);
  const grades = sheet_(ss, SHEET.GRADES, gradeHeaders_());
  const passages = sheet_(ss, SHEET.PASSAGES, ['Level', 'Session', 'Reading text']);
  const applicants = sheet_(ss, SHEET.APPLICANTS, ['ID', 'Time', 'Name', 'Phone / WhatsApp', 'Email', 'Note', 'Status', 'Student code']);
  const live = sheet_(ss, SHEET.LIVE, ['ID', 'Level', 'Start (ISO time)', 'Zoom link', 'Note']);
  const schedule = sheet_(ss, SHEET.SCHEDULE, ['ID', 'Code', 'Level', 'Session', 'Start (ISO time)', 'Note']);

  // Older sheets (version 5 and before) have no "Marks" column yet.
  results.getRange('J1').setValue('Marks').setFontWeight('bold');

  // Older sheets (version 6 and before) kept their help text in column E. Columns D and E are now Level and Months.
  if (String(students.getRange('E1').getValue()) === 'How to use') students.getRange('E1:E5').clearContent();
  students.getRange('D1').setValue('Level').setFontWeight('bold');
  students.getRange('E1').setValue('Months booked').setFontWeight('bold');
  students.getRange(2, 4, students.getMaxRows() - 1, 2).setNumberFormat('0');
  students.getRange('H1').setValue('How to use').setFontWeight('bold');
  students.getRange('H2').setValue('Type a student name in column A. A code appears in column B. Write the level (1-12) in column D and the months booked in column E.');
  students.getRange('H3').setValue('If no code appears, use the Quiz portal menu > Generate missing student codes.');
