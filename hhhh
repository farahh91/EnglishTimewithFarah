  students.getRange('H5').setValue('People who apply on the web app appear in the Applicants sheet. Accept them in the web app (Instructors > New students) to make their code.');
  students.getRange('H6').setValue('A student only sees the quizzes and live sessions of their own level.');

  // Keep codes as text so a code made only of digits never turns into a number.
  students.getRange(2, 2, students.getMaxRows() - 1, 1).setNumberFormat('@');
  results.getRange(2, 3, results.getMaxRows() - 1, 1).setNumberFormat('@');
  results.getRange(2, 8, results.getMaxRows() - 1, 1).setNumberFormat('0%');
  results.getRange(2, 9, results.getMaxRows() - 1, 2).setNumberFormat('@');

