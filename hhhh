function checkSetup() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const lines = [];
  Object.keys(SHEET).forEach(function (k) {
    lines.push((ss.getSheetByName(SHEET[k]) ? 'OK       ' : 'MISSING  ') + SHEET[k] + ' sheet');
  });
  const st = ss.getSheetByName(SHEET.STUDENTS);
  if (st && st.getLastRow() > 1) {
    const v = st.getRange(2, 1, st.getLastRow() - 1, 2).getValues();
    const named = v.filter(function (r) { return String(r[0]).trim(); }).length;
    const coded = v.filter(function (r) { return normCode_(r[1]); }).length;
    lines.push(named + ' students with a name, ' + coded + ' with a code');
  } else lines.push('No students yet');
  const info = quizInfo_();
  lines.push(Object.keys(info).length + ' sessions have a quiz ready, ' + Object.keys(info).filter(function (k) { return info[k].open; }).length + ' of them open');
  lines.push(PropertiesService.getScriptProperties().getProperty('SS_ID') ? 'Sheet is connected to the web app' : 'NOT connected: run Set up sheets');
  lines.push(teacherConfigured_() ? 'Teacher password is set' : 'Teacher password is NOT set: use Quiz portal > Set teacher password');
  lines.push(aiKey_() ? 'AI key is set (writing questions are marked by the AI)' : 'AI key is NOT set: writing questions will wait for you to mark them (Quiz portal > Set AI key)');
  lines.push(waNumber_() ? 'WhatsApp number is set' : 'WhatsApp number is NOT set: voice-note questions will have no button (Quiz portal > Set my WhatsApp number)');
  lines.push(ScriptApp.getService().getUrl() ? 'Web app is deployed' : 'Web app is NOT deployed yet');
  alert_(lines.join('\n'));
}

