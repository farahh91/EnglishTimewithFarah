th[aria-sort] button{color:var(--ink)}
td.num,th.num{text-align:right}
.namebtn{background:none;border:0;padding:0;cursor:pointer;font-weight:600;text-align:left;color:var(--ink)}
.namebtn:hover{color:var(--navy);text-decoration:underline}
tr.detail td{background:var(--bg);padding:14px}
.sgrid{min-width:0;width:auto}
.sgrid th,.sgrid td{padding:5px 8px;text-align:center;border:1px solid var(--line);font-size:.8rem}
.sgrid th:first-child{text-align:left}
.cellbtn{background:var(--soft);border:0;border-radius:8px;padding:4px 8px;cursor:pointer;font-family:var(--mono);font-size:.78rem}
.cellbtn:hover{outline:2px solid var(--navy)}
.cellbtn[aria-pressed="true"]{background:var(--mark);color:#241C00}
.panel{background:var(--paper);border:1px solid var(--line);border-radius:18px;padding:16px 18px;margin-bottom:20px;min-width:0}
.ecard{background:var(--paper);border:1px solid var(--line);border-radius:18px;padding:16px 18px;margin-bottom:12px;display:grid;gap:10px}
.ecard .top{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
.eopt{display:grid;grid-template-columns:auto minmax(0,1fr);gap:10px;align-items:center}
.eopt input[type=radio]{accent-color:var(--navy);width:18px;height:18px}
.rbar{display:grid;grid-template-columns:minmax(0,1fr) 120px 56px;gap:10px;align-items:center;padding:8px 0;border-bottom:1px solid var(--line)}
.rbar:last-child{border-bottom:0}
.toast{position:fixed;left:50%;transform:translateX(-50%);bottom:22px;background:var(--navy-2);color:#fff;padding:12px 22px;border-radius:24px;font-weight:600;z-index:5;max-width:calc(100vw - 32px)}
.toast.bad{background:var(--red)}
@media (max-width:560px){
  .qrow{grid-template-columns:auto minmax(0,1fr)}
  .qrow .act{grid-column:1 / -1;justify-content:flex-start}
  .opts.two{grid-template-columns:1fr}
  .rbar{grid-template-columns:minmax(0,1fr) 70px 48px}
}
</style>
