  // Live grade report: one row per student, calculated from the Results sheet.
  grades.getRange('A2').setFormula('=ARRAYFORMULA(IF(Students!B2:B="","",Students!A2:A))');
  grades.getRange('B2').setFormula('=ARRAYFORMULA(IF(Students!B2:B="","",Students!B2:B))');
  grades.getRange('C2').setFormula('=ARRAYFORMULA(IF(B2:B="","",COUNTIFS(Results!C2:C,B2:B)))');
  grades.getRange('D2').setFormula('=ARRAYFORMULA(IF(B2:B="","",SUMIFS(Results!F2:F,Results!C2:C,B2:B)))');
  grades.getRange('E2').setFormula('=ARRAYFORMULA(IF(B2:B="","",SUMIFS(Results!G2:G,Results!C2:C,B2:B)))');
