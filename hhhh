.word{padding:7px 14px;border-radius:12px;border:2px solid var(--navy);background:var(--paper);color:var(--navy);font-weight:600;cursor:pointer}
.word.in{background:var(--navy);color:#fff}
.passage{background:#FFFBEA;border-color:#EBD98E}
.passage h3{font-size:1.05rem}
.live{border-width:2px}
.live.later{background:var(--soft)}
.live.soon{background:#FFF3CD;border-color:#E0B100}
.live.live{background:var(--good-soft);border-color:var(--good)}
details.panel summary{cursor:pointer;font-weight:600}
.submitbar{position:sticky;bottom:0;margin-top:16px;padding:12px 16px;background:var(--paper);border:1px solid var(--line);border-radius:18px;display:flex;flex-wrap:wrap;gap:10px 16px;align-items:center;justify-content:space-between;box-shadow:0 -6px 18px rgba(30,43,94,.08)}
.submitbar .bar{width:140px}
.bigscore{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 18px;margin-bottom:18px}
.bigscore .v{font-weight:700;font-size:2.8rem;line-height:1}
.bigscore .v small{font-size:1.3rem;color:var(--muted)}

/* instructor area */
.tabs{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:18px;align-items:center}
.tab{padding:8px 18px;border-radius:99px;border:2px solid var(--navy);background:transparent;cursor:pointer;font-weight:600;color:var(--navy)}
.tab[aria-current="page"]{background:var(--navy);color:#fff}
.toolbar{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-bottom:12px}
.toolbar .input{max-width:300px}
.lvbars{display:grid;gap:8px}
.lvbar{display:grid;grid-template-columns:62px minmax(0,1fr) 70px;gap:10px;align-items:center;font-size:.85rem}
