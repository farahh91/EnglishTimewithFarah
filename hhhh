<body>
<div id="app"><p class="loading" style="padding:24px">Loading…</p></div>
<div class="toast" id="toast" role="status" hidden></div>

<script>
(function () {
'use strict';
let LV = 12, SS = 8;
const VERSION = '7';
const START = '__START__';          // the server sets this to "teacher" or "apply" for the ?page= links
const SAVED = 'etf-student';
const root = document.getElementById('app');

/* ---------- state ---------- */
const blankApply = () => ({ name: '', phone: '', email: '', note: '', trap: '', busy: false, error: '', done: false });
const S = {                          // student side
  mode: 'student',                   // student | teacher
  tab: 'login',                      // login | apply (only before logging in)
  apply: blankApply(),
  booting: true,
  live: null, sched: {}, skew: 0, examMin: 120, sessMin: 60, remMin: 5, reminded: {}, lastLs: '',
  student: null, quizzes: {}, results: {}, level: 1,
  view: 'home',                      // home | quiz | result | results
  quiz: null, review: null,
  busy: false, error: '', notice: ''
};
const T = {                          // instructor side
  token: null, over: null, loading: false, view: 'progress',
  busy: false, error: '', notice: '',
  search: '', sort: { by: 'name', dir: 1 }, expanded: null, attempt: null,
  level: 1, report: null,
  namesText: '', rmConfirm: null, showList: false, addBusy: false, editor: null,
  apps: null, appFilter: 'All', appConfirm: null,
  live: null, lf: null, liveConfirm: null, resch: null, newLevel: 1, newMonths: 1
};
let form = { name: '', code: '' };

/* ---------- helpers ---------- */
function el(tag, props, ...kids) {
  const n = document.createElement(tag);
  if (props) for (const k of Object.keys(props)) {
    const v = props[k];
    if (v == null || v === false) continue;
    if (k === 'class') n.className = v;
    else if (k === 'text') n.textContent = v;
    else if (k.indexOf('on') === 0) n.addEventListener(k.slice(2), v);
    else if (k === 'value') n.value = v;
    else if (k === 'checked') n.checked = true;
    else if (k === 'disabled') n.disabled = true;
    else n.setAttribute(k, v === true ? '' : v);
  }
  (function add(list) {
    list.forEach(function (kid) {
      if (kid == null || kid === false) return;
      if (Array.isArray(kid)) return add(kid);
      n.append(kid.nodeType ? kid : document.createTextNode(String(kid)));
    });
  })(kids);
  return n;
}
function call(fn, ...args) {
  return new Promise(function (resolve, reject) {
    const r = google.script.run.withSuccessHandler(resolve).withFailureHandler(reject);
    r[fn].apply(r, args);
  });
}
function lsGet() { try { return JSON.parse(localStorage.getItem(SAVED)); } catch (e) { return null; } }
function lsSet(v) { try { if (v) localStorage.setItem(SAVED, JSON.stringify(v)); else localStorage.removeItem(SAVED); } catch (e) {} }
const pct = (a, b) => b ? Math.round(a / b * 100) : null;
const fmtPct = p => p == null ? '–' : p + '%';
const fmt10 = p => Math.round(Number(p) * 100) / 10;
const wordCount = t => String(t || '').trim().split(/\\s+/).filter(Boolean).length;
const keyOf = (l, s) => l + '-' + s;
const isFinal = s => s === SS;
const sTitle = s => isFinal(s) ? 'Final exam' : 'Session ' + s + ' quiz';
const sSub = s => isFinal(s) ? 'Final exam · one attempt only' : 'After-class quiz';
function fmtTime(iso) { try { return iso ? new Date(iso).toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' }) : ''; } catch (e) { return ''; } }
const TYPE_LABEL = {
  choice: 'Multiple choice', truefalse: 'True / False', fill: 'Fill in the blank', order: 'Word order',
  writing: 'Writing (AI checks it)', voice: 'Voice note (WhatsApp)'
};

let toastTimer = null;
function say(msg, bad, ms) {
  const t = document.getElementById('toast');
  t.textContent = msg; t.className = 'toast' + (bad ? ' bad' : ''); t.hidden = false;
  clearTimeout(toastTimer);
  toastTimer = setTimeout(function () { t.hidden = true; }, ms || 3200);
}

function render() {
  const a = document.activeElement, aid = a && a.id ? a.id : null;
  let ss = null;
  try { ss = a.selectionStart; } catch (e) {}
  let nodes;
  try { nodes = build(); }
  catch (e) { console.error(e); nodes = [el('div', { class: 'wrap' }, el('p', { class: 'notice bad', text: 'Something went wrong. Reload the page to try again.' }))]; }
  root.replaceChildren.apply(root, nodes);
  if (aid) {
    const n = document.getElementById(aid);
    if (n) { n.focus({ preventScroll: true }); if (ss != null) { try { n.setSelectionRange(ss, ss); } catch (e) {} } }
  }
}

function header() {
  return el('header', { class: 'hdr' }, el('div', { class: 'in' },
    el('div', { class: 'logo', 'aria-hidden': 'true', text: 'ET' }),
    el('div', {},
      el('h1', {}, 'English Time with ', el('b', { text: 'Farah' })),
      S.mode === 'teacher' && el('p', { class: 'sub', text: 'Instructor area' }))));
}
function build() {
  const body = build0();
  body.push(el('p', { class: 'muted small', style: 'text-align:center;margin:0 0 22px', text: 'Portal version ' + VERSION }));
  // wrap everything after the header in one centred column
  return [header(), el('main', { class: 'wrap' }, body)];
}
function build0() {
  if (S.booting) return [el('p', { class: 'loading', text: 'Loading…' })];
  if (S.mode === 'teacher') return [teacherRoot()];
  if (!S.student) return [entryTabs(), S.tab === 'apply' ? applyView() : loginView()];
  if (S.view === 'quiz') return [quizView()];
  if (S.view === 'result') return [resultView()];
  if (S.view === 'results') return [resultsView()];
  return [homeView()];
}

/* shared: show a finished quiz, question by question (students and instructor).
   tools (instructor only) = { save(i), ai(i) } adds mark boxes to writing and voice questions. */
function lineOf(label, text, cls, pre) {
  return el('div', { class: 'line' + (cls ? ' ' + cls : '') },
    el('span', { class: 'lab', text: label }),
    el('span', { dir: 'auto', style: pre ? 'white-space:pre-wrap;min-width:0;overflow-wrap:anywhere' : '', text: text }));
}
function markTools(i, it, m, tools) {
  return el('div', { class: 'row', style: 'margin:4px 0 8px' },
    el('input', { class: 'input', id: 'mk-' + i, type: 'number', min: '0', max: '10', step: '0.5', style: 'width:90px', 'aria-label': 'Mark out of 10', value: m.w ? '' : String(fmt10(m.p)) }),
    el('span', { class: 'help', text: '/ 10' }),
    el('input', { class: 'input', id: 'mf-' + i, dir: 'auto', style: 'flex:1;min-width:160px', maxlength: '500', placeholder: 'Feedback for the student (optional)', 'aria-label': 'Feedback', value: m.f || '' }),
    el('button', { class: 'btn small good', type: 'button', onclick: function () { tools.save(i); }, text: 'Save mark' }),
    it.type === 'writing' && el('button', { class: 'btn small', type: 'button', onclick: function () { tools.ai(i); }, text: 'Check with AI' }));
}
function reviewList(items, tools) {
  const out = el('div');
  items.forEach(function (it, i) {
    const body = el('div');
    if (it.type === 'fill') {
      body.append(el('div', { class: 'line ' + (it.right ? 'right' : 'wrong') },
        el('span', { class: 'lab', text: 'Answer' }), el('span', { dir: 'auto', text: String(it.chosen) }),
        el('span', { class: 'lab', style: 'margin-left:auto', text: it.right ? 'Correct' : 'Not correct' })));
      if (it.answers && !it.right) body.append(el('div', { class: 'line' }, el('span', { class: 'lab', text: 'Accepted' }), el('span', { dir: 'auto', text: it.answers.join('  /  ') })));
    } else if (it.type === 'order') {
      body.append(el('div', { class: 'line ' + (it.right ? 'right' : 'wrong') },
        el('span', { class: 'lab', text: 'Answer' }), el('span', { dir: 'auto', text: (it.chosen || []).join(' ') }),
        el('span', { class: 'lab', style: 'margin-left:auto', text: it.right ? 'Correct' : 'Not correct' })));
      if (it.sentence && !it.right) body.append(el('div', { class: 'line' }, el('span', { class: 'lab', text: 'Correct' }), el('span', { dir: 'auto', text: it.sentence })));
    } else if (it.type === 'writing' || it.type === 'voice') {
      const m = it.mark || { p: 0, w: true };
      if (it.type === 'writing') body.append(lineOf('Text', String(it.chosen), '', true));
      else body.append(lineOf('Voice note', 'Sent on WhatsApp', ''));
      if (m.w) body.append(lineOf('Mark', tools ? 'Not marked yet.' : 'Your teacher will check this one.', ''));
      else body.append(lineOf('Mark', fmt10(m.p) + ' / 10', m.p >= 0.6 ? 'right' : ''));
      if (m.f) body.append(lineOf('Feedback', m.f, '', true));
      if (m.c) body.append(lineOf('Better version', m.c, '', true));
      if (tools) body.append(markTools(i, it, m, tools));
    } else {
      const opts = el('div', { class: 'opts' + (it.type === 'truefalse' ? ' two' : '') });
      (it.options || []).forEach(function (o, j) {
        const mine = it.chosen === j, known = it.correct != null, right = known ? it.correct === j : (mine && it.right);
        const cls = right ? 'right' : (mine ? 'wrong' : 'plain');
        const tag = right && mine ? 'Your answer · Correct' : (right ? 'Correct answer' : (mine ? 'Your answer' : ''));
        opts.append(el('div', { class: 'opt ' + cls }, el('span', { dir: 'auto', text: o }), tag && el('span', { class: 'tag', text: tag })));
      });
      body.append(opts);
    }
    out.append(el('div', { class: 'qcard' },
      el('div', { class: 'qtext' }, el('span', { class: 'n', text: String(i + 1) }), el('span', { dir: 'auto', text: it.q })), body));
  });
  return out;
}

/* =====================================================================
   STUDENT SIDE
   ===================================================================== */
function go(view) { S.view = view; S.notice = ''; render(); window.scrollTo(0, 0); }

function entryTabs() {
  const b = function (id, label) {
    return el('button', { class: 'tab', type: 'button', 'aria-current': S.tab === id ? 'page' : null,
      onclick: function () { S.tab = id; S.error = ''; S.apply.error = ''; render(); }, text: label });
  };
  return el('nav', { class: 'tabs', style: 'justify-content:center;max-width:520px;margin:0 auto 4px', 'aria-label': 'Choose where to go' },
    b('login', 'Student login'), b('apply', 'New student? Apply'));
}
function instrLink() {
  return el('p', { class: 'instr' }, el('button', { class: 'linkbtn', type: 'button', onclick: function () { S.mode = 'teacher'; T.error = ''; render(); window.scrollTo(0, 0); }, text: 'Instructors' }));
}

function loginView() {
  return el('div', {},
    el('form', { class: 'card login', onsubmit: function (ev) { ev.preventDefault(); doLogin(); } },
      el('h2', { text: 'Student login' }),
      S.error && el('p', { class: 'notice bad', role: 'alert', text: S.error }),
      el('div', { class: 'field' }, el('label', { for: 'f-name', text: 'Your name' }),
        el('input', { class: 'input', id: 'f-name', dir: 'auto', autocomplete: 'name', maxlength: '60', required: true, value: form.name })),
      el('div', { class: 'field' }, el('label', { for: 'f-code', text: 'Student code' }),
        el('input', { class: 'input mono', id: 'f-code', autocomplete: 'off', autocapitalize: 'characters', maxlength: '32', required: true, value: form.code })),
      el('button', { class: 'btn primary', type: 'submit', disabled: S.busy, text: S.busy ? 'Checking…' : 'Show my quizzes' })),
    instrLink());
}
function doLogin() {
  const name = document.getElementById('f-name').value.trim();
  const code = document.getElementById('f-code').value.replace(/\\s+/g, '').toUpperCase();
  form = { name: name, code: code };
  if (!name) { S.error = 'Write your name first.'; return render(); }
  if (!code) { S.error = 'Write your student code.'; return render(); }
  S.busy = true; S.error = ''; render();
  call('api_login', name, code).then(function (r) {
    S.busy = false;
    if (!r.ok) { S.error = r.error; return render(); }
    enter(r);
    lsSet({ name: name, code: r.code });
  }).catch(function () {
    S.busy = false; S.error = 'Could not reach the server. Check your connection and try again.'; render();
  });
}

/* ---- new student application ---- */
function applyView() {
  const A = S.apply;
  if (A.done) {
    return el('div', {},
      el('div', { class: 'card login' },
        el('h2', { text: 'Thank you!' }),
        el('p', { class: 'notice good', role: 'status', text: 'We received your application. Your teacher will contact you soon on WhatsApp or by email.' }),
        el('button', { class: 'btn', type: 'button', onclick: function () { S.apply = blankApply(); render(); }, text: 'Send another application' })),
      instrLink());
  }
  const keep = function (k) { return function (ev) { A[k] = ev.target.value; }; };
  return el('div', {},
    el('form', { class: 'card login', onsubmit: function (ev) { ev.preventDefault(); doApply(); } },
      el('h2', { text: 'Apply for the course' }),
      el('p', { class: 'help', text: 'Write your details. Your teacher will contact you.' }),
      A.error && el('p', { class: 'notice bad', role: 'alert', text: A.error }),
      el('div', { class: 'field' }, el('label', { for: 'a-name', text: 'Your full name' }),
        el('input', { class: 'input', id: 'a-name', dir: 'auto', autocomplete: 'name', maxlength: '80', required: true, value: A.name, oninput: keep('name') })),
      el('div', { class: 'field' }, el('label', { for: 'a-phone', text: 'Phone or WhatsApp number' }),
        el('input', { class: 'input mono', id: 'a-phone', type: 'tel', autocomplete: 'tel', maxlength: '24', required: true, placeholder: '+20 10 1234 5678', value: A.phone, oninput: keep('phone') })),
      el('div', { class: 'field' }, el('label', { for: 'a-email', text: 'Email' }),
        el('input', { class: 'input', id: 'a-email', type: 'email', autocomplete: 'email', maxlength: '120', required: true, value: A.email, oninput: keep('email') })),
      el('div', { class: 'field' }, el('label', { for: 'a-note', text: 'Anything you want to tell your teacher? (optional)' }),
        el('textarea', { class: 'input', id: 'a-note', dir: 'auto', maxlength: '300', value: A.note, oninput: keep('note') })),
      el('div', { class: 'hp', 'aria-hidden': 'true' }, el('label', { for: 'a-site', text: 'Leave this empty' }),
        el('input', { id: 'a-site', tabindex: '-1', autocomplete: 'off', value: A.trap, oninput: keep('trap') })),
      el('button', { class: 'btn primary', type: 'submit', disabled: A.busy, text: A.busy ? 'Sending…' : 'Send my application' })),
    instrLink());
}
function doApply() {
  const A = S.apply;
  A.name = document.getElementById('a-name').value.trim();
  A.phone = document.getElementById('a-phone').value.trim();
  A.email = document.getElementById('a-email').value.trim();
  A.note = document.getElementById('a-note').value.trim();
  A.trap = document.getElementById('a-site').value;
  if (!A.name) { A.error = 'Write your name.'; return render(); }
  if (!A.phone) { A.error = 'Write your phone or WhatsApp number.'; return render(); }
  if (!A.email) { A.error = 'Write your email.'; return render(); }
  A.busy = true; A.error = ''; render();
  call('api_apply', A.name, A.phone, A.email, A.note, A.trap).then(function (r) {
    A.busy = false;
    if (!r.ok) { A.error = r.error; return render(); }
    S.apply = Object.assign(blankApply(), { done: true }); render(); window.scrollTo(0, 0);
  }).catch(function () {
    A.busy = false; A.error = 'Could not reach the server. Check your connection and try again.'; render();
  });
}

function applyStudentData(r) {
  S.student.level = r.level || 0;
  S.student.months = r.months || 0;
  S.quizzes = r.quizzes || {}; S.results = r.results || {}; S.sched = r.sched || {};
  S.live = r.live || null;
  if (r.now) S.skew = r.now - Date.now();
  if (r.examMinutes) S.examMin = r.examMinutes;
  if (r.sessionMinutes) S.sessMin = r.sessionMinutes;
  if (r.reminderMinutes) S.remMin = r.reminderMinutes;
  S.level = S.student.level || 1;
}
function enter(r) {
  if (r.levels) LV = r.levels;
  if (r.sessions) SS = r.sessions;
  S.student = { name: r.name, code: r.code, level: 0, months: 0 };
  applyStudentData(r);
  S.view = 'home'; S.error = ''; S.mode = 'student'; render(); window.scrollTo(0, 0);
}
function logout() {
  lsSet(null); S.student = null; S.quiz = null; S.review = null; S.view = 'home'; S.tab = 'login';
  form = { name: '', code: '' }; render(); window.scrollTo(0, 0);
}
function refreshHome(loud) {
  return call('api_home', S.student.code).then(function (r) {
    if (!r.ok) { logout(); S.error = r.error; render(); return; }
    applyStudentData(r); render();
    if (loud) say('Updated');
  }).catch(function () { if (loud) say('Could not refresh. Check your connection.', true); });
}

function nowMs() { return Date.now() + (S.skew || 0); }
const fmtMonths = n => n + (n === 1 ? ' month' : ' months');

/* where one quiz stands for this student: done, open, soon (scheduled for later), late, closed, none */
function examState(l, s) {
  const k = keyOf(l, s), r = S.results[k], q = S.quizzes[k], sc = S.sched[k];
  if (r) return { kind: 'done' };
  if (!q) return { kind: 'none' };
  if (sc) {
    const t0 = Date.parse(sc.start), t1 = t0 + S.examMin * 60000, now = nowMs();
    if (now < t0) return { kind: 'soon', start: sc.start };
    if (now <= t1) return { kind: 'open' };
    return { kind: 'late' };
  }
  return { kind: q.open ? 'open' : 'closed' };
}

/* the live Zoom session: none, ended, later, soon (reminder time), live */
function liveState() {
  const L = S.live;
  if (!L) return 'none';
  const t0 = Date.parse(L.start), t1 = t0 + S.sessMin * 60000, now = nowMs();
  if (now >= t1) return 'ended';
  if (now >= t0) return 'live';
  if (t0 - now <= S.remMin * 60000) return 'soon';
  return 'later';
