  }
  grades.getRange(2, 6, grades.getMaxRows() - 1, 1 + CONFIG.LEVELS).setNumberFormat('0%');
  grades.getRange('T1').setValue('Class average').setFontWeight('bold');
  grades.getRange('T2').setFormula('=IFERROR(SUM(Results!F2:F)/SUM(Results!G2:G),"")').setNumberFormat('0%');
  grades.getRange('U1').setValue('Students').setFontWeight('bold');
  grades.getRange('U2').setFormula('=COUNTA(Students!B2:B)');
  control.getRange(2, 1, control.getMaxRows() - 1, 2).setNumberFormat('0');

  ss.toast('Setup finished. Add student names in the Students sheet and quizzes in the Quizzes sheet.', 'Quiz portal', 8);
}

function gradeHeaders_() {
  const h = ['Name', 'Code', 'Quizzes done', 'Points', 'Points possible', 'Overall %'];
  for (let n = 1; n <= CONFIG.LEVELS; n++) h.push('Level ' + n);
  return h;
}

function sheet_(ss, name, headers) {
  const sh = ss.getSheetByName(name) || ss.insertSheet(name);
  if (sh.getLastRow() === 0) {
    sh.getRange(1, 1, 1, headers.length).setValues([headers]).setFontWeight('bold');
    sh.setFrozenRows(1);
  }
  return sh;
}

function testCode() {
  const ui = ui_();
  if (!ui) { alert_('Open the Google Sheet and use the Quiz portal menu there. This one needs the Sheet window.'); return; }
  const res = ui.prompt('Test a student code', 'Type the code exactly as the student would:', ui.ButtonSet.OK_CANCEL);
  if (res.getSelectedButton() !== ui.Button.OK) return;
  const st = findStudent_(res.getResponseText());
  alert_(st ? 'This code works. It belongs to: ' + st.name : 'This code was NOT found in the Students sheet (column B).');
