function waLink_(name, code, l, s, n) {
  const num = waNumber_();
  if (!num) return '';
  const msg = 'Hello teacher, this is ' + name + ' (ID ' + code + '). ' +
    (s === CONFIG.SESSIONS ? 'Final exam' : 'Level ' + l + ', Session ' + s) + ', question ' + n + '. My voice note:';
  return 'https://wa.me/' + num + '?text=' + encodeURIComponent(msg);
}
function getQuiz_(code, level, session) {
  const st = findStudent_(code);
  if (!st) return { ok: false, error: 'Your code was not recognised. Log in again.' };
  const l = int_(level, CONFIG.LEVELS), s = int_(session, CONFIG.SESSIONS);
  if (!l || !s) return { ok: false, error: 'That session does not exist.' };
  if (findResult_(st.code, l, s)) return { ok: false, error: 'You already took this quiz.' };
  const qs = readQuizzes_()[l + '-' + s];
  if (!qs || !qs.length) return { ok: false, error: 'This quiz is not ready yet.' };
  const acc = examAccess_(st, l, s, false);
  if (!acc.ok) return acc;
  return {
    ok: true, level: l, session: s, final: s === CONFIG.SESSIONS,
    passage: readPassages_()[l + '-' + s] || '',
    questions: qs.map(function (q, i) {
      if (q.type === 'fill') return { type: 'fill', q: q.q };
      if (q.type === 'order') return { type: 'order', q: q.q, words: shuffleWords_(q.words) };
      if (q.type === 'writing') return { type: 'writing', q: q.q };
      if (q.type === 'voice') return { type: 'voice', q: q.q, wa: waLink_(st.name, st.code, l, s, i + 1) };
      return { type: q.type, q: q.q, options: q.options };
    })
  };
}

function api_submit(code, level, session, answers) {
  return safe_(function () { return submit_(code, level, session, answers); });
}
function submit_(code, level, session, answers) {
  const st = findStudent_(code);
  if (!st) return { ok: false, error: 'Your code was not recognised. Log in again.' };
  const l = int_(level, CONFIG.LEVELS), s = int_(session, CONFIG.SESSIONS);
  if (!l || !s) return { ok: false, error: 'That session does not exist.' };
  if (findResult_(st.code, l, s)) return { ok: false, error: 'You already took this quiz.' };
  const qs = readQuizzes_()[l + '-' + s];
  if (!qs || !qs.length) return { ok: false, error: 'This quiz is not ready yet.' };
  const acc = examAccess_(st, l, s, true);
  if (!acc.ok) return acc;
  if (!Array.isArray(answers) || answers.length !== qs.length) return { ok: false, error: 'Answer every question first.' };

  // Mark everything. Writing is sent to the AI (all writing answers at the same time) BEFORE the sheet is locked,
  // so one slow marking does not make other students wait.
  const clean = [], marks = [], jobs = [], jobAt = [];
  for (let i = 0; i < qs.length; i++) {
    const g = grade_(qs[i], answers[i]);
    if (!g) return { ok: false, error: 'Answer every question first.' };
    clean.push(g.clean);
    if (g.manual) {
      marks.push({ p: 0, w: 1 });
      if (qs[i].type === 'writing') { jobs.push({ q: qs[i], level: l, text: g.clean }); jobAt.push(i); }
    } else marks.push({ p: g.right ? 1 : 0 });
  }
  if (jobs.length) {
    const outs = aiGradeAll_(jobs);
    jobAt.forEach(function (qi, k) {
      const o = outs[k];
      if (o && o.ok) marks[qi] = { p: o.pts, f: o.feedback, c: o.corrected };
      // If the AI did not answer, the question stays "waiting" (w) and the teacher marks it by hand.
    });
  }
  const score = sumMarks_(marks);

  const lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    if (findResult_(st.code, l, s)) return { ok: false, error: 'You already took this quiz.' };
    const sh = db_().getSheetByName(SHEET.RESULTS);
    sh.appendRow([new Date(), st.name, st.code, l, s, score, qs.length, score / qs.length, JSON.stringify(clean), JSON.stringify(marks)]);
    removeSchedule_(st.code, l, s);   // a personal exam time is used up once the exam is sent
  } finally {
    lock.releaseLock();
  }
  return {
    ok: true, level: l, session: s, score: score, total: qs.length,
    pending: marks.filter(function (m) { return m && m.w; }).length,
    passage: readPassages_()[l + '-' + s] || '',
    items: reviewItems_(qs, clean, revealFor_(s), marks)
  };
}

function api_review(code, level, session) {
  return safe_(function () { return review_(code, level, session); });
}
function review_(code, level, session) {
  const st = findStudent_(code);
  if (!st) return { ok: false, error: 'Your code was not recognised. Log in again.' };
  const l = int_(level, CONFIG.LEVELS), s = int_(session, CONFIG.SESSIONS);
  const r = l && s ? findResult_(st.code, l, s) : null;
  if (!r) return { ok: false, error: 'No result found for this quiz.' };
  const qs = readQuizzes_()[l + '-' + s];
  const ok = qs && qs.length === r.total && r.answers && r.answers.length === r.total;
  return {
    ok: true, level: l, session: s, score: r.score, total: r.total, pending: r.pending,
    passage: readPassages_()[l + '-' + s] || '',
    items: ok ? reviewItems_(qs, r.answers, revealFor_(s), r.marks) : null
