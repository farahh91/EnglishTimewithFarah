function api_t_addStudents(token, names, level, months) {
  return teacher_(token, function () {
    if (!Array.isArray(names)) return { ok: false, error: 'Paste at least one name.' };
    const clean = names.map(function (n) { return String(n == null ? '' : n).replace(/\s+/g, ' ').trim().slice(0, 60); })
      .filter(Boolean).slice(0, 300);
    if (!clean.length) return { ok: false, error: 'Paste at least one name.' };
    const lock = LockService.getScriptLock();
    lock.waitLock(20000);
    try {
      const sh = db_().getSheetByName(SHEET.STUDENTS);
      if (!sh) return { ok: false, error: 'The Students sheet is missing. Run setup first.' };
      const used = new Set();
      if (sh.getLastRow() > 1) {
        sh.getRange(2, 2, sh.getLastRow() - 1, 1).getValues().forEach(function (r) { const c = normCode_(r[0]); if (c) used.add(c); });
