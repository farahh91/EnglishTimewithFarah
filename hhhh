  quizzes.getRange('I1').setValue('Type').setFontWeight('bold');
  quizzes.getRange('K1').setValue('Question types (column I)').setFontWeight('bold');
  quizzes.getRange('K2').setValue('choice (or empty): options in A-D, Correct = A, B, C or D');
  quizzes.getRange('K3').setValue('truefalse: Correct = A (True) or B (False)');
  quizzes.getRange('K4').setValue('fill: type the answer. Correct = accepted answers separated by |   e.g.  goes|is going');
  quizzes.getRange('K5').setValue('order: students put scrambled words in order. Correct = the full correct sentence');
  quizzes.getRange('K6').setValue('writing: students write a text and the AI marks it. Correct = what the AI should look for (optional)');
  quizzes.getRange('K7').setValue('voice: students send a voice note on WhatsApp and you give the mark. Correct = a note for you (optional)');
  quizzes.getRange('K8').setValue('Reading texts are kept in the Passages sheet (one text per level and session). Easiest: add them in the web app, Quizzes > Edit.');
  control.getRange('E1').setValue('Open quizzes').setFontWeight('bold');
  control.getRange('E2').setValue('A quiz is open for students only when it has a row here with Open = TRUE.');
  control.getRange('E3').setValue('Easiest: open and close quizzes in the web app (Instructors > Quizzes).');
  passages.getRange(2, 3, passages.getMaxRows() - 1, 1).setNumberFormat('@');
  applicants.getRange(2, 1, applicants.getMaxRows() - 1, 8).setNumberFormat('@');
  live.getRange(2, 1, live.getMaxRows() - 1, 5).setNumberFormat('@');
