/* ---- quizzes ---- */

/** One session's quiz as the teacher edits it. */
function readQuizRaw_(l, s) {
  const sh = db_().getSheetByName(SHEET.QUIZZES);
  const out = [];
  if (!sh || sh.getLastRow() < 2) return out;
  sh.getRange(2, 1, sh.getLastRow() - 1, 9).getValues().forEach(function (r) {
    const q = parseQuizRow_(r);
    if (!q || q.l !== l || q.s !== s) return;
    if (q.type === 'fill') out.push({ type: 'fill', q: q.q, answers: q.answers });
    else if (q.type === 'order') out.push({ type: 'order', q: q.q, sentence: q.sentence });
    else if (q.type === 'writing') out.push({ type: 'writing', q: q.q, rubric: q.rubric });
    else if (q.type === 'voice') out.push({ type: 'voice', q: q.q, note: q.note });
    else out.push({ type: q.type, q: q.q, opts: q.slots, correct: q.slot });
  });
  return out;
}

function api_t_getQuiz(token, level, session) {
  return teacher_(token, function () {
    const l = int_(level, CONFIG.LEVELS), s = int_(session, CONFIG.SESSIONS);
    if (!l || !s) return { ok: false, error: 'That session does not exist.' };
    return { ok: true, level: l, session: s, questions: readQuizRaw_(l, s), passage: readPassages_()[l + '-' + s] || '' };
  });
}

/** Replaces every row of one session's quiz in the Quizzes sheet. */
function writeQuiz_(l, s, newRows) {
  const lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    const sh = db_().getSheetByName(SHEET.QUIZZES);
    if (!sh) throw new Error('The Quizzes sheet is missing. Run setup first.');
    const last = sh.getLastRow();
    const all = last > 1 ? sh.getRange(2, 1, last - 1, 9).getValues() : [];
    const kept = all.filter(function (r) {
      const blank = r.every(function (v) { return String(v).trim() === ''; });
      return !blank && !(int_(r[0], CONFIG.LEVELS) === l && int_(r[1], CONFIG.SESSIONS) === s);
    });
    const final = kept.concat(newRows);
    ensureRows_(sh, final.length + 1);
    if (last > 1) sh.getRange(2, 1, last - 1, 9).clearContent();
    if (final.length) {
      sh.getRange(2, 3, final.length, 7).setNumberFormat('@');
      sh.getRange(2, 1, final.length, 9).setValues(final);
    }
  } finally {
    lock.releaseLock();
  }
}

/** The reading text of one session (empty text removes it). */
function writePassage_(l, s, text) {
  const lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    const sh = db_().getSheetByName(SHEET.PASSAGES);
    if (!sh) throw new Error('The Passages sheet is missing. Run setup first.');
    const last = sh.getLastRow();
    const all = last > 1 ? sh.getRange(2, 1, last - 1, 3).getValues() : [];
    const kept = all.filter(function (r) {
      const blank = r.every(function (v) { return String(v).trim() === ''; });
      return !blank && !(int_(r[0], CONFIG.LEVELS) === l && int_(r[1], CONFIG.SESSIONS) === s);
    });
    if (text) kept.push([l, s, text]);
    ensureRows_(sh, kept.length + 1);
    if (last > 1) sh.getRange(2, 1, last - 1, 3).clearContent();
    if (kept.length) {
      sh.getRange(2, 3, kept.length, 1).setNumberFormat('@');
      sh.getRange(2, 1, kept.length, 3).setValues(kept);
    }
  } finally {
    lock.releaseLock();
  }
}

function api_t_saveQuiz(token, level, session, questions, passage) {
  return teacher_(token, function () {
    const l = int_(level, CONFIG.LEVELS), s = int_(session, CONFIG.SESSIONS);
    if (!l || !s) return { ok: false, error: 'That session does not exist.' };
    if (!Array.isArray(questions) || !questions.length || questions.length > 60) {
      return { ok: false, error: 'A quiz needs between 1 and 60 questions.' };
    }
    const rows = [];
    for (let i = 0; i < questions.length; i++) {
      const q = questions[i] || {};
      const n = 'Question ' + (i + 1);
      const text = String(q.q == null ? '' : q.q).replace(/\r/g, '').trim().slice(0, 500);
      const type = typeOf_(q.type);
      if (!text) return { ok: false, error: n + ' is empty.' };
      if (type === 'fill') {
        const answers = (Array.isArray(q.answers) ? q.answers : String(q.answers || '').split('|'))
          .map(function (a) { return String(a == null ? '' : a).replace(/[|\r\n]/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 100); })
          .filter(Boolean).slice(0, 10);
        if (!answers.length) return { ok: false, error: n + ': write at least one accepted answer.' };
        rows.push([l, s, text, '', '', '', '', answers.join('|'), 'fill']);
      } else if (type === 'order') {
        const sentence = String(q.sentence == null ? '' : q.sentence).replace(/\s+/g, ' ').trim().slice(0, 300);
        const nw = wordsOf_(sentence).length;
        if (nw < 2 || nw > 25) return { ok: false, error: n + ': the sentence needs 2 to 25 words.' };
        rows.push([l, s, text, '', '', '', '', sentence, 'order']);
      } else if (type === 'writing') {
        const rubric = String(q.rubric == null ? '' : q.rubric).replace(/\s+/g, ' ').trim().slice(0, 400);
        rows.push([l, s, text, '', '', '', '', rubric, 'writing']);
      } else if (type === 'voice') {
        const note = String(q.note == null ? '' : q.note).replace(/\s+/g, ' ').trim().slice(0, 400);
        rows.push([l, s, text, '', '', '', '', note, 'voice']);
      } else if (type === 'truefalse') {
        const c = Number(q.correct);
        if (c !== 0 && c !== 1) return { ok: false, error: n + ': choose True or False as the correct answer.' };
        rows.push([l, s, text, 'True', 'False', '', '', c === 0 ? 'A' : 'B', 'truefalse']);
      } else {
        const opts = (Array.isArray(q.opts) ? q.opts : []).slice(0, 4).map(function (o) { return String(o == null ? '' : o).trim().slice(0, 200); });
        while (opts.length < 4) opts.push('');
        const correct = Number(q.correct);
        if (opts.filter(Boolean).length < 2) return { ok: false, error: n + ' needs at least two options.' };
        if (!Number.isInteger(correct) || correct < 0 || correct > 3 || !opts[correct]) {
          return { ok: false, error: n + ': the correct answer points to an empty option.' };
        }
        rows.push([l, s, text, opts[0], opts[1], opts[2], opts[3], 'ABCD'.charAt(correct), 'choice']);
      }
    }
    writeQuiz_(l, s, rows);
    writePassage_(l, s, String(passage == null ? '' : passage).replace(/\r/g, '').trim().slice(0, 6000));
    return { ok: true, count: rows.length };
  });
}

function api_t_deleteQuiz(token, level, session) {
  return teacher_(token, function () {
    const l = int_(level, CONFIG.LEVELS), s = int_(session, CONFIG.SESSIONS);
    if (!l || !s) return { ok: false, error: 'That session does not exist.' };
    writeQuiz_(l, s, []);
    writePassage_(l, s, '');
    return { ok: true };
  });
}

/* ====================== Data helpers ====================== */

/** Finds the Sheet: the ID in CONFIG, else the one saved by setup(), else the Sheet this script is attached to. */
function findBook_() {
  const id = CONFIG.SPREADSHEET_ID || PropertiesService.getScriptProperties().getProperty('SS_ID');
  if (id) {
    try { return SpreadsheetApp.openById(String(id).trim()); } catch (e) { /* try the next way */ }
  }
  try { return SpreadsheetApp.getActiveSpreadsheet(); } catch (e) { return null; }
}

function db_() {
  const ss = findBook_();
  if (!ss) throw new Error('The sheet is not connected. In the Apps Script editor choose setup and press Run.');
  return ss;
}

/** Runs an api function and turns any crash into a readable message for the page. */
function safe_(fn) {
  try { return fn(); }
  catch (e) { return { ok: false, error: 'Server problem: ' + (e && e.message ? e.message : e) }; }
}

function int_(v, max) {
  const n = Number(v);
  return Number.isInteger(n) && n >= 1 && n <= max ? n : 0;
}

function findStudent_(code) {
  const c = normCode_(code);
  if (!c) return null;
  const sh = db_().getSheetByName(SHEET.STUDENTS);
  if (!sh || sh.getLastRow() < 2) return null;
  const vals = sh.getRange(2, 1, sh.getLastRow() - 1, 5).getValues();
  for (let i = 0; i < vals.length; i++) {
    if (normCode_(vals[i][1]) === c) {
      return {
        name: String(vals[i][0]).trim(), code: c,
        level: int_(vals[i][3], CONFIG.LEVELS), months: Math.max(0, Math.round(Number(vals[i][4]) || 0))
      };
    }
  }
  return null;
}

/** Opens or closes quizzes. session = 0 means every session of that level that has a quiz. */
function api_t_setOpen(token, level, session, open) {
  return teacher_(token, function () {
    const l = int_(level, CONFIG.LEVELS);
    const all = Number(session) === 0;
    const s = all ? 0 : int_(session, CONFIG.SESSIONS);
    if (!l || (!all && !s)) return { ok: false, error: 'That session does not exist.' };
    const want = !!open;
    const have = readQuizzes_();
    const lock = LockService.getScriptLock();
    lock.waitLock(20000);
    try {
      const sh = db_().getSheetByName(SHEET.CONTROL);
      if (!sh) return { ok: false, error: 'The Control sheet is missing. Run setup first.' };
      const cur = openMap_();
      const keys = all ? Object.keys(have).filter(function (k) { return k.split('-')[0] === String(l); }) : [l + '-' + s];
      if (!all && want && !(have[keys[0]] && have[keys[0]].length)) return { ok: false, error: 'Add questions to this session first.' };
      keys.forEach(function (k) { if (want) cur[k] = true; else delete cur[k]; });
      const rows = Object.keys(cur).map(function (k) { const p = k.split('-'); return [Number(p[0]), Number(p[1]), true]; })
        .sort(function (a, b) { return a[0] - b[0] || a[1] - b[1]; });
      const last = sh.getLastRow();
      if (last > 1) sh.getRange(2, 1, last - 1, 3).clearContent();
      if (rows.length) {
        ensureRows_(sh, rows.length + 1);
        sh.getRange(2, 1, rows.length, 3).setValues(rows);
      }
      return { ok: true, quizzes: quizInfo_() };
    } finally {
      lock.releaseLock();
    }
  });
}

/** One student's attempt with every question, their answer and whether it was right. */
function api_t_attempt(token, code, level, session) {
  return teacher_(token, function () {
    const c = normCode_(code), l = int_(level, CONFIG.LEVELS), s = int_(session, CONFIG.SESSIONS);
    const st = findStudent_(c);
    const r = st && l && s ? findResult_(c, l, s) : null;
    if (!r) return { ok: false, error: 'No attempt found.' };
    const qs = readQuizzes_()[l + '-' + s];
    const usable = qs && qs.length === r.total && r.answers && r.answers.length === r.total;
    return {
      ok: true, name: st.name, level: l, session: s, score: r.score, total: r.total, time: r.time,
      items: usable ? reviewItems_(qs, r.answers, true, r.marks) : null
    };
  });
}

/** Class report for one session: who took it, and how many got each question right. */
function api_t_quizReport(token, level, session) {
  return teacher_(token, function () {
    const l = int_(level, CONFIG.LEVELS), s = int_(session, CONFIG.SESSIONS);
    if (!l || !s) return { ok: false, error: 'That session does not exist.' };
    const qs = readQuizzes_()[l + '-' + s] || [];
    const names = {};
    const sh = db_().getSheetByName(SHEET.STUDENTS);
    if (sh && sh.getLastRow() > 1) {
      sh.getRange(2, 1, sh.getLastRow() - 1, 2).getValues().forEach(function (r) {
        const c = normCode_(r[1]), n = String(r[0]).trim();
        if (c && n) names[c] = n;
      });
    }
    const right = qs.map(function () { return 0; });
    const takers = [], done = {};
    readResults_().forEach(function (r) {
      const c = normCode_(r[2]);
      if (!names[c] || Number(r[3]) !== l || Number(r[4]) !== s) return;
      done[c] = true;
      takers.push({ name: names[c], code: c, score: Number(r[5]), total: Number(r[6]), time: isoTime_(r[0]), pending: pendingOf_(r[9]) });
      const ans = parseAnswers_(r[8]), marks = parseAnswers_(r[9]);
      if (ans && ans.length === qs.length) {
        qs.forEach(function (q, i) {
          if (isManual_(q.type)) {
            const m = marks && marks[i];
            if (m && !m.w && Number(m.p) >= 0.6) right[i]++;
            return;
          }
          const g = grade_(q, ans[i]);
          if (g && g.right) right[i]++;
        });
      }
    });
    const waiting = Object.keys(names).filter(function (c) { return !done[c]; }).map(function (c) { return { name: names[c], code: c }; });
    return {
      ok: true, level: l, session: s, taken: takers.length,
      questions: qs.map(function (q, i) { return { type: q.type, q: q.q, right: right[i] }; }),
      takers: takers, waiting: waiting
    };
  });
}

/* ====================== Quiz data helpers ====================== */

const TYPE_ALIASES = {
  '': 'choice', 'choice': 'choice', 'mcq': 'choice', 'multiple': 'choice', 'multiplechoice': 'choice',
  'truefalse': 'truefalse', 'tf': 'truefalse', 'true/false': 'truefalse', 'trueorfalse': 'truefalse',
  'fill': 'fill', 'blank': 'fill', 'fillin': 'fill', 'fillintheblank': 'fill', 'write': 'fill', 'type': 'fill',
  'order': 'order', 'unscramble': 'order', 'reorder': 'order', 'scramble': 'order',
  'writing': 'writing', 'essay': 'writing', 'paragraph': 'writing', 'ai': 'writing',
  'voice': 'voice', 'voicenote': 'voice', 'whatsapp': 'voice', 'speaking': 'voice', 'audio': 'voice'
};

function typeOf_(v) {
  const k = String(v == null ? '' : v).toLowerCase().replace(/[\s_\-]+/g, '');
  return TYPE_ALIASES[k] || 'choice';
}

/** Writing and voice questions are marked by the AI or by the teacher, not by comparing text. */
function isManual_(type) { return type === 'writing' || type === 'voice'; }

function sumMarks_(marks) {
  let t = 0;
  marks.forEach(function (m) { t += m && isFinite(Number(m.p)) ? Number(m.p) : 0; });
  return Math.round(t * 100) / 100;
}

function pendingOf_(cell) {
  const m = parseAnswers_(cell);
  return m ? m.filter(function (x) { return x && x.w; }).length : 0;
}

/** Lower-case, no punctuation, one space between words: how typed answers are compared. */
function normAns_(t) {
  return String(t == null ? '' : t)
    .replace(/[‘’]/g, "'").replace(/[“”]/g, '"')
    .toLowerCase()
    .replace(/[.,!?;:"()]/g, ' ')
    .replace(/\s+/g, ' ').trim();
}

function wordsOf_(sentence) {
  return String(sentence == null ? '' : sentence).trim().split(/\s+/).filter(Boolean);
}

function shuffleWords_(words) {
  const w = words.slice();
  for (let t = 0; t < 8; t++) {
    for (let i = w.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      const tmp = w[i]; w[i] = w[j]; w[j] = tmp;
    }
    if (w.length < 2 || w.join(' ') !== words.join(' ')) break;
  }
  return w;
}

/**
 * One row of the Quizzes sheet -> a question, or null when the row is not usable.
 * { type, q, options[], correct (index in options), answers[] (fill), sentence/words (order),
 *   rubric (writing), note (voice),
 *   slots[4] and slot (editor view: the four option cells and the correct one 0-3) }
 */
function parseQuizRow_(r) {
  const l = int_(r[0], CONFIG.LEVELS), s = int_(r[1], CONFIG.SESSIONS);
  const q = String(r[2]).trim();
  if (!l || !s || !q) return null;
  const type = typeOf_(r[8]);
  const key = String(r[7]).trim();
  const out = { l: l, s: s, type: type, q: q };
  if (type === 'fill') {
    out.answers = key.split('|').map(function (a) { return a.trim(); }).filter(Boolean);
    if (!out.answers.length) return null;
    return out;
  }
  if (type === 'order') {
    out.sentence = key.replace(/\s+/g, ' ');
    out.words = wordsOf_(out.sentence);
    if (out.words.length < 2) return null;
    return out;
  }
  if (type === 'writing') { out.rubric = key; return out; }
  if (type === 'voice') { out.note = key; return out; }
  const slots = [3, 4, 5, 6].map(function (i) { return String(r[i]).trim(); });
  let k = key.toUpperCase();
  if (type === 'truefalse') {
    if (!slots[0]) slots[0] = 'True';
    if (!slots[1]) slots[1] = 'False';
    slots[2] = ''; slots[3] = '';
    if (k === 'T' || k === 'TRUE') k = 'A';
    if (k === 'F' || k === 'FALSE') k = 'B';
  }
  if (/^[1-4]$/.test(k)) k = 'ABCD'.charAt(Number(k) - 1);
  const slot = 'ABCD'.indexOf(k);
  const options = [], map = {};
  slots.forEach(function (t, j) { if (t) { map[j] = options.length; options.push(t); } });
  if (options.length < 2 || slot < 0 || map[slot] === undefined) return null;
  out.options = options;
  out.correct = map[slot];
  out.slots = slots;
  out.slot = slot;
  return out;
}

/** Returns { "1-1": [question, ...], ... } from the Quizzes sheet. */
function readQuizzes_() {
  const sh = db_().getSheetByName(SHEET.QUIZZES);
  const out = {};
  if (!sh || sh.getLastRow() < 2) return out;
  sh.getRange(2, 1, sh.getLastRow() - 1, 9).getValues().forEach(function (r) {
    const q = parseQuizRow_(r);
    if (q) (out[q.l + '-' + q.s] = out[q.l + '-' + q.s] || []).push(q);
  });
  return out;
}

/** Reading texts: { "1-1": "text", ... } from the Passages sheet. */
function readPassages_() {
  const sh = db_().getSheetByName(SHEET.PASSAGES);
  const out = {};
  if (!sh || sh.getLastRow() < 2) return out;
  sh.getRange(2, 1, sh.getLastRow() - 1, 3).getValues().forEach(function (r) {
    const l = int_(r[0], CONFIG.LEVELS), s = int_(r[1], CONFIG.SESSIONS), t = String(r[2]).trim();
    if (l && s && t) out[l + '-' + s] = t;
  });
  return out;
}

/** Which sessions are open: { "1-1": true, ... } from the Control sheet. */
function openMap_() {
  const sh = db_().getSheetByName(SHEET.CONTROL);
  const out = {};
  if (!sh || sh.getLastRow() < 2) return out;
  sh.getRange(2, 1, sh.getLastRow() - 1, 3).getValues().forEach(function (r) {
    const l = int_(r[0], CONFIG.LEVELS), s = int_(r[1], CONFIG.SESSIONS);
    const v = String(r[2]).trim().toLowerCase();
    if (l && s && (r[2] === true || v === 'true' || v === 'yes' || v === 'open' || v === '1')) out[l + '-' + s] = true;
  });
  return out;
}

/** { "1-1": { n: number of questions, open: true/false } } for every session that has a quiz. */
function quizInfo_() {
  const all = readQuizzes_(), open = openMap_(), out = {};
  Object.keys(all).forEach(function (k) { out[k] = { n: all[k].length, open: !!open[k] }; });
  return out;
}

function readResults_() {
  const sh = db_().getSheetByName(SHEET.RESULTS);
  if (!sh || sh.getLastRow() < 2) return [];
  return sh.getRange(2, 1, sh.getLastRow() - 1, 10).getValues();
}

function resultsFor_(code, level) {
  const out = {};
  readResults_().forEach(function (r) {
    if (normCode_(r[2]) === code && Number(r[3]) === level) out[r[3] + '-' + r[4]] = { score: Number(r[5]), total: Number(r[6]), pending: pendingOf_(r[9]) };
  });
  return out;
}

function parseAnswers_(cell) {
  try { const a = JSON.parse(cell); return Array.isArray(a) ? a : null; } catch (e) { return null; }
}

function findResult_(code, l, s) {
  const rows = readResults_();
  for (let i = 0; i < rows.length; i++) {
    const r = rows[i];
    if (normCode_(r[2]) === code && Number(r[3]) === l && Number(r[4]) === s) {
      return { score: Number(r[5]), total: Number(r[6]), answers: parseAnswers_(r[8]), marks: parseAnswers_(r[9]), pending: pendingOf_(r[9]), time: isoTime_(r[0]) };
    }
  }
  return null;
}

function isoTime_(d) {
  try { return d instanceof Date ? d.toISOString() : String(d || ''); } catch (e) { return ''; }
}

/**
 * Checks the shape of one answer. Returns { right, clean } for normal questions,
 * { manual: true, clean } for writing and voice (marked later), or null when the answer has the wrong shape.
 */
function grade_(q, a) {
  if (q.type === 'writing') {
    if (typeof a !== 'string') return null;
    const t = a.replace(/[ \t]+/g, ' ').replace(/\n{3,}/g, '\n\n').trim().slice(0, 2000);
    if (!t) return null;
    return { manual: true, clean: t };
  }
  if (q.type === 'voice') {
    if (a !== 'sent') return null;
    return { manual: true, clean: 'sent' };
  }
  if (q.type === 'fill') {
    if (typeof a !== 'string') return null;
    const t = a.replace(/\s+/g, ' ').trim().slice(0, 200);
    if (!t) return null;
    return { clean: t, right: q.answers.some(function (x) { return normAns_(x) === normAns_(t); }) };
  }
  if (q.type === 'order') {
    if (!Array.isArray(a) || a.length !== q.words.length) return null;
    const w = a.map(function (x) { return String(x == null ? '' : x).slice(0, 80); });
    return { clean: w, right: normAns_(w.join(' ')) === normAns_(q.sentence) };
  }
  const n = Number(a);
  if (a === null || a === '' || !Number.isInteger(n) || n < 0 || n >= q.options.length) return null;
  return { clean: n, right: n === q.correct };
}

/** One entry per question: what was asked, what the student answered, and whether it was right. */
function reviewItems_(qs, answers, reveal, marks) {
  return qs.map(function (q, i) {
    if (isManual_(q.type)) {
      const m = marks && marks[i] ? marks[i] : null;
      const it = { type: q.type, q: q.q, chosen: answers[i] };
      if (m && !m.w) {
        it.mark = { p: Number(m.p) || 0, w: false, f: m.f || '', c: reveal ? (m.c || '') : '' };
        it.right = it.mark.p >= 0.6;
      } else {
        it.mark = { p: 0, w: true, f: '', c: '' };
        it.right = false;
      }
      return it;
    }
    const g = grade_(q, answers[i]);
    const it = { type: q.type, q: q.q, chosen: answers[i], right: !!(g && g.right) };
    if (q.type === 'order') it.words = q.words;
    if (q.options) it.options = q.options;
    if (reveal) {
      if (q.type === 'fill') it.answers = q.answers;
      else if (q.type === 'order') it.sentence = q.sentence;
      else it.correct = q.correct;
    }
    return it;
  });
}

