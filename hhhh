function setWhatsApp() {
  const ui = ui_();
  if (!ui) { alert_('Open the Google Sheet and use the Quiz portal menu there. This one needs the Sheet window.'); return; }
  const res = ui.prompt('Your WhatsApp number',
    'Write your number with the country code, digits only. Example for Egypt: 201012345678', ui.ButtonSet.OK_CANCEL);
